{
  "name": "@regops/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "migrate:run": "pnpm build && node ./node_modules/typeorm/cli.js -d dist/data-source.js migration:run",
    "migrate:revert": "pnpm build && node ./node_modules/typeorm/cli.js -d dist/data-source.js migration:revert",
    "migrate:generate": "pnpm build && node ./node_modules/typeorm/cli.js -d dist/data-source.js migration:generate",
    "seed": "ts-node src/seed/seed.ts",
    "bootstrap": "ts-node src/seed/bootstrap.ts"
  },
  "dependencies": {
    "@regops/risk-engine": "workspace:*",
    "@regops/rules-engine": "workspace:*",
    "@regops/shared": "workspace:*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@regops/config": "workspace:*",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
