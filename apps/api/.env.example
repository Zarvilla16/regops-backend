# Application connects with this (regops_app role, NO BYPASSRLS) so RLS is enforced.
DATABASE_URL=postgres://regops_app:regops_app_password@127.0.0.1:5433/regops

# Migrations and seeds run with this (regops_admin role, BYPASSRLS).
DATABASE_ADMIN_URL=postgres://regops_admin:regops_admin_password@127.0.0.1:5433/regops

REDIS_URL=redis://127.0.0.1:6379

# Must be at least 64 characters. Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-to-a-random-64-plus-character-secret-before-deploying-anywhere
JWT_ACCESS_TTL=15m

# Must be different from JWT_ACCESS_SECRET and at least 64 characters.
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-plus-character-secret-value-here
JWT_REFRESH_TTL=30d

# File storage: unset = local disk (dev). Set CLOUDINARY_URL — required when NODE_ENV=production.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_ROOT_FOLDER=regops-prod

# E-mail (invites, password reset). Without RESEND_API_KEY nothing is sent: in development the message,
# including its link, is printed in the API log. FRONTEND_URL is the base of those links (defaults to the
# first CORS origin).
# FRONTEND_URL=http://localhost:3000
# RESEND_API_KEY=
# MAIL_FROM=RegOps <no-reply@your-verified-domain>

CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
PORT=4000
MFA_ISSUER=RegOps

# Seed script credentials (dev/demo only - never use in production)
SEED_SUPER_ADMIN_EMAIL=superadmin@regops.dev
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin!2026
SEED_TENANT_ADMIN_PASSWORD=TenantAdmin!2026
SEED_COMPLIANCE_OFFICER_PASSWORD=Compliance!2026
