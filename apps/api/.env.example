# Application connects with this (regops_app role, NO BYPASSRLS) so RLS is enforced.
DATABASE_URL=postgres://regops_app:regops_app_password@localhost:5433/regops

# Migrations and seeds run with this (regops_admin role, BYPASSRLS).
DATABASE_ADMIN_URL=postgres://regops_admin:regops_admin_password@localhost:5433/regops

REDIS_URL=redis://localhost:6379

# Must be at least 64 characters. Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-to-a-random-64-plus-character-secret-before-deploying-anywhere
JWT_ACCESS_TTL=15m

# Must be different from JWT_ACCESS_SECRET and at least 64 characters.
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-plus-character-secret-value-here
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
PORT=4000
MFA_ISSUER=RegOps

# Seed script credentials (dev/demo only - never use in production)
SEED_SUPER_ADMIN_EMAIL=superadmin@regops.dev
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin!2026
SEED_TENANT_ADMIN_PASSWORD=TenantAdmin!2026
SEED_COMPLIANCE_OFFICER_PASSWORD=Compliance!2026
